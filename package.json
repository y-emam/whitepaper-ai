{
  "name": "whitepaper-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Citation-grounded RAG search engine over AWS whitepapers, with a Next.js web UI and an MCP server.",
  "scripts": {
    "dev": "pnpm --filter @whitepaper-ai/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "ingest": "pnpm --filter @whitepaper-ai/ingestion start",
    "ingest:scrape": "pnpm --filter @whitepaper-ai/ingestion scrape",
    "mcp": "pnpm --filter @whitepaper-ai/mcp-server start",
    "mcp:build": "pnpm --filter @whitepaper-ai/mcp-server build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3",
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.1"
  }
}
