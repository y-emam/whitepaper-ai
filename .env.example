# Supabase — get these from the Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voyage AI — embeddings (https://www.voyageai.com/)
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3-large
VOYAGE_EMBED_DIMENSIONS=1024

# Gemini — answer LLM only (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# Tuning
RETRIEVAL_TOP_K=8
RETRIEVAL_VECTOR_WEIGHT=0.6
RETRIEVAL_FTS_WEIGHT=0.4
RETRIEVAL_REFUSAL_THRESHOLD=0.4

# Ingestion
INGEST_CONCURRENCY=2
